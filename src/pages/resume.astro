---
import Layout from '~/layouts/Layout.astro'

const TYP_PATH = '/resume/chirag-singhal-resume.typ'
const PDF_PATH = '/resume/chirag-singhal-resume.pdf'

const profiles = [
  {
    id: 'software',
    label: 'Software & AI Engineer',
    kicker: 'PRIMARY',
    desc: 'Backend, full-stack & applied AI — Python, TypeScript, Go, FastAPI, Kubernetes.',
    pdf: '/resume/software/chirag-singhal-software.pdf',
    typ: '/resume/software/chirag-singhal-software.typ',
    pdfName: 'chirag-singhal-software.pdf',
  },
  {
    id: 'ai-consulting',
    label: 'AI / Prompt Engineering Consultant',
    kicker: 'HIGHEST RATE',
    desc: 'Prompt engineering, RAG, multi-agent orchestration, LLM evals, MCP servers.',
    pdf: '/resume/ai-consulting/chirag-singhal-ai-consulting.pdf',
    typ: '/resume/ai-consulting/chirag-singhal-ai-consulting.typ',
    pdfName: 'chirag-singhal-ai-consulting.pdf',
  },
  {
    id: 'finance',
    label: 'Financial Analyst',
    kicker: 'REPO-BACKED',
    desc: 'Equity valuation, portfolio optimization (max-Sharpe), live market-signal tools.',
    pdf: '/resume/finance/chirag-singhal-finance.pdf',
    typ: '/resume/finance/chirag-singhal-finance.typ',
    pdfName: 'chirag-singhal-finance.pdf',
  },
  {
    id: 'data-analysis',
    label: 'Data Analyst',
    kicker: 'REPO-BACKED',
    desc: 'Python (pandas), SQL, dashboards, ETL pipelines, automated reporting.',
    pdf: '/resume/data-analysis/chirag-singhal-data-analysis.pdf',
    typ: '/resume/data-analysis/chirag-singhal-data-analysis.typ',
    pdfName: 'chirag-singhal-data-analysis.pdf',
  },
  {
    id: 'tutoring',
    label: 'Tutor — Coding, JEE/Maths, English',
    kicker: 'CREDENTIAL-BACKED',
    desc: 'JEE Advanced AIR 11870 · B.Tech CSE Rank 1 · teaches Python, DSA, JEE maths, English.',
    pdf: '/resume/tutoring/chirag-singhal-tutoring.pdf',
    typ: '/resume/tutoring/chirag-singhal-tutoring.typ',
    pdfName: 'chirag-singhal-tutoring.pdf',
  },
]
---

<Layout
  title="Résumé"
  description="Chirag Singhal — résumé. Download the PDF or copy the Typst source."
>

  <div class="page-header animate-in">
    <div class="kicker">WORK · RÉSUMÉ</div>
    <h1 class="text-display">Résumé</h1>
    <p class="page-sub">Single-column, ATS-friendly. Download the PDF, or copy the Typst source.</p>
  </div>

  <!-- Action bar -->
  <div class="resume-actions animate-in">
    <a href={PDF_PATH} download="chirag-singhal-resume.pdf" class="action-btn action-btn--primary">
      <span class="action-icon" aria-hidden="true">↓</span>
      Download PDF
    </a>
    <button id="btn-copy" class="action-btn action-btn--ghost" data-path={TYP_PATH}>
      <span class="action-icon" aria-hidden="true">⎘</span>
      <span id="btn-copy-label">Copy Typst source</span>
    </button>
    <a href="https://typst.app" target="_blank" rel="noopener noreferrer" class="action-btn action-btn--ghost">
      <span class="action-icon" aria-hidden="true">↗</span>
      Edit in Typst
    </a>
  </div>

  <!-- Preview panel -->
  <div class="signal-strip resume-panel animate-in">
    <div class="resume-preview" id="resume-preview">
      <div class="preview-loading" id="preview-loading">
        <span class="glow-dot"></span>
        <span>Loading source…</span>
      </div>
      <pre id="resume-code" class="resume-code hidden" aria-label="Typst source"></pre>
    </div>
  </div>

  <!-- Compile note -->
  <div class="compile-note animate-in">
    <span class="kicker">HOW TO USE</span>
    <ol class="compile-steps">
      <li>Click <strong>Copy Typst source</strong> above.</li>
      <li>Open <a href="https://typst.app" target="_blank" rel="noopener" class="link-pill">typst.app ↗</a> → New blank project.</li>
      <li>Paste the source into <code class="text-code">main.typ</code> — it compiles automatically.</li>
      <li>Download the compiled PDF, or grab the PDF directly from the button above.</li>
    </ol>
  </div>

  <!-- Profile résumés -->
  <div class="profiles-section animate-in">
    <div class="profiles-header">
      <div class="kicker">FIELD-SPECIFIC · 5 PROFILES</div>
      <h2 class="profiles-title">Profile Résumés</h2>
      <p class="profiles-sub">Tailored for each freelance context. Same facts, different focus.</p>
    </div>
    <div class="profiles-grid">
      {profiles.map((p) => (
        <div class="profile-card">
          <div class="profile-card-top">
            <span class="profile-kicker">{p.kicker}</span>
            <h3 class="profile-label">{p.label}</h3>
            <p class="profile-desc">{p.desc}</p>
          </div>
          <div class="profile-card-actions">
            <a href={p.pdf} download={p.pdfName} class="action-btn action-btn--primary action-btn--sm">
              <span class="action-icon" aria-hidden="true">↓</span>
              Download PDF
            </a>
            <button
              class="action-btn action-btn--ghost action-btn--sm profile-copy-btn"
              data-typ={p.typ}
              data-label={`Copy ${p.label} Typst`}
            >
              <span class="action-icon" aria-hidden="true">⎘</span>
              <span class="copy-btn-label">Copy Typst</span>
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>

</Layout>

<script>
  async function init() {
    const btn = document.getElementById('btn-copy') as HTMLButtonElement | null
    const label = document.getElementById('btn-copy-label')
    const pre = document.getElementById('resume-code')
    const loading = document.getElementById('preview-loading')

    if (!btn || !label || !pre || !loading) return

    const path = btn.dataset.path!

    let src = ''
    try {
      const res = await fetch(path)
      if (!res.ok) throw new Error('fetch failed')
      src = await res.text()
      pre.textContent = src
      loading.classList.add('hidden')
      pre.classList.remove('hidden')
    } catch {
      loading.innerHTML = '<span style="color:var(--amber)">Could not load source — use the Download button.</span>'
    }

    btn.addEventListener('click', async () => {
      const text = src || pre.textContent || ''
      if (!text) return
      try {
        await navigator.clipboard.writeText(text)
        label.textContent = 'Copied!'
        btn.classList.add('action-btn--copied')
        setTimeout(() => {
          label.textContent = 'Copy Typst source'
          btn.classList.remove('action-btn--copied')
        }, 2200)
      } catch {
        label.textContent = 'Copy failed — use Download'
        setTimeout(() => { label.textContent = 'Copy Typst source' }, 2200)
      }
    })

    // Profile copy buttons
    document.querySelectorAll<HTMLButtonElement>('.profile-copy-btn').forEach((pbtn) => {
      pbtn.addEventListener('click', async () => {
        const typPath = pbtn.dataset.typ!
        const span = pbtn.querySelector<HTMLElement>('.copy-btn-label')
        if (!span) return
        try {
          const res = await fetch(typPath)
          if (!res.ok) throw new Error('fetch failed')
          const text = await res.text()
          await navigator.clipboard.writeText(text)
          span.textContent = 'Copied!'
          pbtn.classList.add('action-btn--copied')
          setTimeout(() => {
            span.textContent = 'Copy Typst'
            pbtn.classList.remove('action-btn--copied')
          }, 2200)
        } catch {
          span.textContent = 'Failed'
          setTimeout(() => { span.textContent = 'Copy Typst' }, 2200)
        }
      })
    })
  }

  init()
</script>

<style>
  /* ── Action bar ── */
  .resume-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 2rem;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    padding: 0 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    border-radius: var(--r-md);
    border: 1px solid transparent;
    transition: background var(--ease), border-color var(--ease), color var(--ease), transform var(--ease);
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
  }

  .action-btn--primary {
    background: var(--phosphor);
    color: var(--void);
    border-color: var(--phosphor);
  }
  .action-btn--primary:hover {
    background: #58eace;
    border-color: #58eace;
    transform: translateY(-1px);
  }
  .action-btn--primary.action-btn--copied {
    background: var(--phosphor-dim);
    border-color: var(--phosphor-dim);
  }

  .action-btn--ghost {
    background: color-mix(in srgb, var(--phosphor) 8%, var(--panel));
    color: var(--phosphor);
    border-color: color-mix(in srgb, var(--phosphor) 28%, transparent);
  }
  .action-btn--ghost:hover {
    background: color-mix(in srgb, var(--phosphor) 16%, var(--panel));
    border-color: color-mix(in srgb, var(--phosphor) 50%, transparent);
    transform: translateY(-1px);
  }

  .action-icon {
    font-size: 14px;
    line-height: 1;
  }

  /* ── Preview panel ── */
  .resume-panel {
    margin-bottom: 2rem;
    padding: 0;
    max-height: 68vh;
    overflow: hidden;
  }

  .resume-preview {
    max-height: 68vh;
    overflow-y: auto;
    padding: 28px 24px 24px;
  }

  .preview-loading {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 16px 0;
  }

  .resume-code {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.65;
    color: var(--ink-2);
    white-space: pre;
    overflow-x: auto;
    tab-size: 2;
  }

  /* phosphor glow on Typst keywords */
  .resume-code :global(.kw) {
    color: var(--phosphor);
  }

  .hidden {
    display: none !important;
  }

  /* ── Compile note ── */
  .compile-note {
    background: var(--panel);
    border: 1px solid var(--hair);
    border-radius: var(--r-md);
    padding: 20px 22px;
  }

  .compile-note .kicker {
    margin-bottom: 1rem;
  }

  .compile-steps {
    list-style: decimal;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .compile-steps li {
    font-size: 13.5px;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .compile-steps strong {
    color: var(--ink);
  }

  /* ── Animate-in ── */
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .animate-in {
    animation: fade-up 0.38s var(--ease-slow) both;
  }
  .resume-actions.animate-in { animation-delay: 0.06s; }
  .resume-panel.animate-in   { animation-delay: 0.12s; }
  .compile-note.animate-in   { animation-delay: 0.18s; }
  .profiles-section.animate-in { animation-delay: 0.24s; }

  /* ── Profile résumés section ── */
  .profiles-section {
    margin-top: 3rem;
  }

  .profiles-header {
    margin-bottom: 1.5rem;
  }

  .profiles-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0.35rem 0 0.4rem;
  }

  .profiles-sub {
    font-size: 13px;
    color: var(--ink-3);
    margin: 0;
  }

  .profiles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }

  .profile-card {
    background: var(--panel);
    border: 1px solid var(--hair);
    border-radius: var(--r-md);
    padding: 18px 18px 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color var(--ease), box-shadow var(--ease);
  }

  .profile-card:hover {
    border-color: color-mix(in srgb, var(--phosphor) 40%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--phosphor) 12%, transparent);
  }

  .profile-card-top {
    flex: 1;
  }

  .profile-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--phosphor);
    opacity: 0.75;
    margin-bottom: 5px;
  }

  .profile-label {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 6px;
    line-height: 1.35;
  }

  .profile-desc {
    font-size: 12px;
    color: var(--ink-3);
    line-height: 1.55;
    margin: 0;
  }

  .profile-card-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .action-btn--sm {
    height: 30px;
    padding: 0 12px;
    font-size: 11px;
  }
</style>
