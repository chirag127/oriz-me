---
import Layout from '~/layouts/Layout.astro'

const skillGroups = [
  {
    label: 'Languages',
    skills: ['TypeScript (primary)', 'Python', 'JavaScript', 'SQL', 'Bash', 'HTML5', 'CSS3'],
  },
  {
    label: 'Frontend',
    skills: ['React.js', 'Astro', 'Tailwind CSS', 'Browser extensions (Chrome/Firefox)', 'MDX', 'PWA'],
  },
  {
    label: 'Backend',
    skills: ['Node.js', 'FastAPI', 'Flask', 'Express.js', 'REST APIs', 'Cloudflare Workers', 'Serverless'],
  },
  {
    label: 'AI / LLM',
    skills: ['MCP server development', 'RAG pipelines', 'Google Gemini', 'Groq', 'Mistral AI', 'NVIDIA NIM', 'Web scraping (httpx/Playwright/BeautifulSoup)'],
  },
  {
    label: 'Data / Storage',
    skills: ['Neon Postgres', 'Supabase', 'Turso (LibSQL)', 'Redis', 'MongoDB', 'git-as-DB pipelines'],
  },
  {
    label: 'Infrastructure',
    skills: ['Cloudflare Workers & Pages', 'Firebase', 'GitHub Actions', 'Docker', 'Wrangler CLI'],
  },
  {
    label: 'Payments & Auth',
    skills: ['Razorpay (Orders/Webhooks)', 'Clerk Auth', 'OAuth 2.0'],
  },
]
---

<Layout title="Skills" description="Technical skills — languages, backend, cloud, AI, DevOps, security, and more." active="/skills/">

  <div class="section-title">
    <span class="kicker">Technical Skills</span>
    <h1>Skills</h1>
  </div>

  <div class="skills-table">
    {skillGroups.map(group => (
      <div class="skill-row card">
        <span class="group-label">{group.label}</span>
        <div class="chip-list">
          {group.skills.map(skill => (
            <span class="chip">{skill}</span>
          ))}
        </div>
      </div>
    ))}
  </div>

</Layout>

<style>
.section-title {
  margin-bottom: 2rem;
}

.section-title h1 {
  font-family: system-ui, -apple-system, sans-serif;
  font-weight: 600;
  letter-spacing: -0.02em;
  font-size: 2rem;
  color: var(--fg);
  line-height: 1.25;
}

.skills-table {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  max-width: 70rem;
}

.skill-row {
  display: grid;
  grid-template-columns: 14rem 1fr;
  gap: 1.25rem;
  align-items: start;
  padding: 1rem 1.25rem;
}

.group-label {
  font-family: var(--font-ui);
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding-top: 0.15rem;
  white-space: nowrap;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

@media (max-width: 600px) {
  .skill-row {
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }

  .group-label {
    font-size: 0.7rem;
  }
}
</style>
