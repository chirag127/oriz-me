---
/*
 * Data pre-fetched to: public/data/lastfm-top-tracks.json,
 * public/data/lastfm-window.json (which period actually had data)
 */
import Layout from '~/layouts/Layout.astro'
import { readFileSync } from 'fs'
import { join } from 'path'

const load = (name: string, fallback: any) => {
  try { return JSON.parse(readFileSync(join(process.cwd(), 'public/data', name), 'utf-8')) }
  catch { return fallback }
}

const tracks: any[] = load('lastfm-top-tracks.json', []).slice(0, 20)

const win: any = load('lastfm-window.json', {})
const PERIOD: Record<string, string> = {
  '1month': 'Last 30 days', '3month': 'Last 3 months', '6month': 'Last 6 months',
  '12month': 'Last 12 months', overall: 'All time',
}
const periodLabel = PERIOD[win.period] ?? 'Recent'
const note = win.last_scrobble
  ? `last scrobble ${win.last_scrobble}${win.period !== '1month' ? ' — window widened because nothing is more recent' : ''}`
  : ''
---
<Layout title="Top Tracks · Music" active="/library/music/top-tracks/">
  <div class="page-header">
    <div class="kicker">MUSIC · TOP TRACKS</div>
    <h1>Top tracks</h1>
    <p class="muted">{periodLabel} · Last.fm{note ? ` · ${note}` : ''}</p>
  </div>

  {tracks.length === 0 ? (
    <div class="empty-state"><p>No scrobbles in any window · see /me/sources/</p></div>
  ) : (
    <ol class="rows">
      {tracks.map((t: any, i: number) => {
        const art = t.image?.find((im: any) => im?.['#text'])?.['#text'] ?? ''
        const initial = String(t.name ?? '?').trim().charAt(0).toUpperCase()
        return (
          <li class="row">
            {art
              ? <img src={art} alt="" class="thumb" loading="lazy" width="36" height="36" />
              : <span class="thumb thumb--empty" aria-hidden="true">{initial}</span>}
            <span class="rank">{String(i + 1).padStart(2, '0')}</span>
            <span class="info">
              <span class="name">{t.name}</span>
              <span class="sub">{t.artist?.name ?? t.artist?.['#text'] ?? ''}</span>
            </span>
            <span class="meta">{Number(t.playcount ?? 0).toLocaleString()} plays</span>
          </li>
        )
      })}
    </ol>
  )}

  <p class="foot">
    Last.fm no longer returns artwork URLs in this response, so a cover appears only where one is still
    supplied; the rest fall back to an initial rather than an empty box.
  </p>
</Layout>

<style>
  .page-header { margin-bottom: 1.5rem; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .row { display: flex; align-items: center; gap: 10px; padding: 7px 4px; border-bottom: 1px solid var(--hair); }
  .row:last-child { border-bottom: 0; }
  .thumb { width: 36px; height: 36px; border-radius: 4px; object-fit: cover; flex: none; }
  .thumb--empty {
    display: grid; place-items: center; background: var(--panel-2);
    border: 1px solid var(--hair); font-family: var(--font-mono); font-size: 13px; color: var(--ink-3);
  }
  .rank { font-family: var(--font-mono); font-size: 10px; color: var(--ink-4); width: 1.4rem; flex: none; }
  .info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .name { font-size: 0.86rem; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sub { font-size: 0.74rem; color: var(--ink-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .meta { font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-4); flex: none; }
  .empty-state { padding: 1.5rem; border: 1px dashed var(--hair); border-radius: var(--r-md); font-size: 0.84rem; color: var(--ink-3); }
  .foot { margin-top: 1.4rem; font-size: 0.72rem; color: var(--ink-4); border-top: 1px solid var(--hair); padding-top: 0.8rem; }
</style>
