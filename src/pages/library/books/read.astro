---
/*
 * API: https://api.hardcover.app/v1/graphql
 * Data pre-fetched to: public/data/hardcover-read.json
 * Hardcover profile: https://hardcover.app/@chirag127
 */
import Layout from '~/layouts/Layout.astro'
import PosterGrid from '~/components/PosterGrid.astro'
import { readFileSync } from 'fs'
import { join } from 'path'

let read: any[] = []
try { read = JSON.parse(readFileSync(join(process.cwd(), 'public/data/hardcover-read.json'), 'utf-8')) }
catch {}

const cards = read.map((b: any) => ({
  title: b.title,
  cover: b.cover,
  color: b.color,
  href: b.slug ? `https://hardcover.app/books/${b.slug}` : undefined,
  sub: b.author,
  rating: b.rating,
}))
---

<Layout title="Books Read" active="/library/books/">
  <div class="page-header">
    <div class="kicker">BOOKS · READ</div>
    <h1>Read</h1>
    <p class="muted">{read.length} books · <a href="https://hardcover.app/@chirag127" target="_blank" rel="noopener">Hardcover ↗</a></p>
  </div>

  {read.length === 0
    ? <PosterGrid items={[]} empty="No books marked as read yet — add them on Hardcover and the shelf refills on the next data refresh." />
    : <PosterGrid items={cards} empty="" />}
</Layout>
