---
/*
 * API: https://api.hardcover.app/v1/graphql
 * Data pre-fetched to: public/data/hardcover-want.json
 * Hardcover profile: https://hardcover.app/@chirag127
 */
import Layout from '~/layouts/Layout.astro'
import PosterGrid from '~/components/PosterGrid.astro'
import { readFileSync } from 'fs'
import { join } from 'path'

let wantToRead: any[] = []
try { wantToRead = JSON.parse(readFileSync(join(process.cwd(), 'public/data/hardcover-want.json'), 'utf-8')) }
catch {}

const cards = wantToRead.map((b: any) => ({
  title: b.title,
  cover: b.cover,
  color: b.color,
  href: b.slug ? `https://hardcover.app/books/${b.slug}` : undefined,
  sub: b.author,
}))
---

<Layout title="Want to Read" active="/library/books/">
  <div class="page-header">
    <div class="kicker">BOOKS · WANT TO READ</div>
    <h1>Want to Read</h1>
    <p class="muted">{wantToRead.length} books queued · <a href="https://hardcover.app/@chirag127" target="_blank" rel="noopener">Hardcover ↗</a></p>
  </div>

  {wantToRead.length === 0
    ? <PosterGrid items={[]} empty="Nothing queued yet — the want-to-read shelf fills from Hardcover." />
    : <PosterGrid items={cards} empty="" />}
</Layout>
