---
/**
 * /library/podcasts — keyless. Show metadata and artwork come from the iTunes
 * Search API, episodes from each show's own RSS feed (see scripts/fetch-data.ts).
 * No Podcast Index key is involved, so this works on a fork with no credentials.
 */
import { readFileSync, existsSync } from 'fs'
import { join } from 'path'
import Layout from '~/layouts/Layout.astro'

const dataFile = join(process.cwd(), 'public/data/podcasts-enriched.json')
const SHOWS: any[] = existsSync(dataFile) ? JSON.parse(readFileSync(dataFile, 'utf-8')) : []

const shows = SHOWS.filter((s) => s?.title)
const episodes = shows.reduce((n, s) => n + (s.episodes?.length ?? 0), 0)
const newest = shows
  .flatMap((s) => (s.episodes ?? []).map((e: any) => ({ ...e, show: s.title, art: s.image })))
  .map((e: any) => ({ ...e, t: Date.parse(e.date) || 0 }))
  .sort((a: any, b: any) => b.t - a.t)
  .slice(0, 6)

const fmt = (d: string) => {
  const t = Date.parse(d)
  return Number.isNaN(t) ? '' : new Date(t).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}
---

<Layout title="Podcasts" active="/library/podcasts/">
  <div class="page-header">
    <div class="kicker">LIBRARY · PODCASTS</div>
    <h1>Podcasts</h1>
    <p class="muted">
      {shows.length} shows, {episodes} recent episodes. Artwork and episodes come from iTunes Search and each
      show's own RSS feed — no key required.
    </p>
  </div>

  {newest.length > 0 && (
    <section class="latest">
      <h2>Newest across all shows</h2>
      <ul>
        {newest.map((e: any) => (
          <li>
            <a href={e.url} target="_blank" rel="noopener">
              <span class="etitle">{e.title}</span>
              <span class="eshow">{e.show}</span>
              <span class="edate">{fmt(e.date)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="grid">
    {shows.map((s) => (
      <article class="show">
        {s.image
          ? <img src={s.image} alt="" class="art" loading="lazy" width="72" height="72" />
          : <span class="art art--empty" aria-hidden="true">{s.title.charAt(0)}</span>}
        <div class="body">
          <h2><a href={s.link || s.feedUrl} target="_blank" rel="noopener">{s.title}</a></h2>
          {s.artist && <p class="artist">{s.artist}</p>}
          {(s.episodes ?? []).length > 0 && (
            <ul class="eps">
              {s.episodes.map((e: any) => (
                <li>
                  <a href={e.url} target="_blank" rel="noopener">{e.title}</a>
                  <span class="edate">{fmt(e.date)}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </article>
    ))}
  </div>
</Layout>

<style>
  .latest { margin-bottom: 2rem; }
  .latest h2 { margin: 0 0 8px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .latest ul, .eps { list-style: none; margin: 0; padding: 0; }
  .latest li { border-bottom: 1px solid var(--hair); }
  .latest a { display: grid; grid-template-columns: minmax(0, 1fr) 12rem 7rem; gap: 12px; padding: 8px 2px; align-items: baseline; }
  .etitle { font-size: 0.84rem; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .eshow { font-size: 0.74rem; color: var(--ink-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .edate { font-family: var(--font-mono); font-size: 0.66rem; color: var(--ink-4); text-align: right; }
  .latest a:hover .etitle { color: var(--phosphor); }

  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .show {
    display: flex; gap: 12px; padding: 12px; background: var(--panel);
    border: 1px solid var(--hair); border-radius: var(--r-md);
  }
  .art { width: 72px; height: 72px; border-radius: 6px; object-fit: cover; flex: none; }
  .art--empty { display: grid; place-items: center; background: var(--panel-2); font-family: var(--font-mono); color: var(--ink-3); }
  .body { min-width: 0; flex: 1; }
  .body h2 { margin: 0; font-family: var(--font-display); font-size: 0.9rem; font-weight: 600; }
  .body h2 a { color: var(--ink); }
  .body h2 a:hover { color: var(--phosphor); }
  .artist { margin: 1px 0 6px; font-size: 0.72rem; color: var(--ink-4); }
  .eps li { display: flex; justify-content: space-between; gap: 10px; padding: 3px 0; }
  .eps a { font-size: 0.76rem; color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .eps a:hover { color: var(--phosphor); }

  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; }
    .latest a { grid-template-columns: minmax(0, 1fr) auto; }
    .eshow { display: none; }
  }
</style>
