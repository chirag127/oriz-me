---
/**
 * /library — the index. Every library route is listed here exactly once, so the
 * hub stays the complete map even when a section is empty and the rail hides it.
 */
import Layout from '~/layouts/Layout.astro'
import { readFileSync, existsSync } from 'fs'
import { join } from 'path'

const count = (file: string): number => {
  const p = join(process.cwd(), 'public/data', file)
  if (!existsSync(p)) return 0
  try {
    const d = JSON.parse(readFileSync(p, 'utf-8'))
    return Array.isArray(d) ? d.length : d && typeof d === 'object' ? Object.keys(d).length : 0
  } catch { return 0 }
}

type Link = { href: string; label: string; files?: string[] }

const groups: { title: string; note: string; links: Link[] }[] = [
  {
    title: 'Music',
    note: 'Last.fm scrobbles, ListenBrainz as the second source',
    links: [
      { href: '/library/music/', label: 'Overview' },
      { href: '/library/music/top-artists/', label: 'Top artists', files: ['lastfm-top-artists.json'] },
      { href: '/library/music/top-tracks/', label: 'Top tracks', files: ['lastfm-top-tracks.json'] },
      { href: '/library/music/stats/', label: 'Stats', files: ['lastfm-user.json'] },
    ],
  },
  {
    title: 'Film and TV',
    note: 'Watch history from Trakt, schedules and discovery from TMDB',
    links: [
      { href: '/library/movies/', label: 'Movies', files: ['trakt-movies.json'] },
      { href: '/library/movies/watched/', label: 'Watched', files: ['trakt-movies.json'] },
      { href: '/library/movies/watchlist/', label: 'Watchlist', files: ['trakt-watchlist.json'] },
      { href: '/library/tv/', label: 'TV shows', files: ['trakt-shows.json'] },
      { href: '/library/tv/watching/', label: 'Watching', files: ['trakt-shows.json'] },
      { href: '/library/tv/completed/', label: 'Completed', files: ['trakt-shows.json'] },
    ],
  },
  {
    title: 'Anime and manga',
    note: 'AniList first, MyAnimeList as the second source',
    links: [
      { href: '/library/anime/', label: 'Anime', files: ['anilist-anime-completed.json', 'anilist-anime-watching.json', 'anilist-anime-plan.json'] },
      { href: '/library/anime/completed/', label: 'Finished anime', files: ['anilist-anime-completed.json', 'mal-anime-completed.json'] },
      { href: '/library/anime/plan-to-watch/', label: 'Plan to watch', files: ['anilist-anime-plan.json', 'mal-anime-plan.json'] },
      { href: '/library/manga/', label: 'Manga', files: ['anilist-manga-completed.json', 'anilist-manga-reading.json', 'anilist-manga-plan.json'] },
      { href: '/library/manga/completed/', label: 'Finished manga', files: ['anilist-manga-completed.json', 'mal-manga-completed.json'] },
      { href: '/library/manga/plan-to-read/', label: 'Plan to read', files: ['anilist-manga-plan.json', 'mal-manga-plan.json'] },
    ],
  },
  {
    title: 'Books',
    note: 'Shelves from Hardcover, covers from Hardcover and Open Library',
    links: [
      { href: '/library/books/', label: 'Overview' },
      { href: '/library/books/read/', label: 'Read', files: ['hardcover-read.json'] },
      { href: '/library/books/want-to-read/', label: 'Want to read', files: ['hardcover-want.json'] },
      { href: '/library/books/reading/', label: 'Reading', files: ['hardcover-reading.json', 'moonreader-books.json'] },
    ],
  },
  {
    title: 'Everything else',
    note: 'Games, videos, podcasts, and the combined feed',
    links: [
      { href: '/library/shelf/', label: 'Everything on the shelf', files: ['hardcover-read.json', 'hardcover-want.json', 'anilist-anime-completed.json', 'anilist-manga-completed.json'] },
      { href: '/library/gaming/', label: 'Gaming', files: ['games-enriched.json', 'games-manual.json'] },
      { href: '/library/videos/', label: 'Videos', files: ['youtube-recent.json'] },
      { href: '/library/podcasts/', label: 'Podcasts', files: ['podcasts-enriched.json'] },
      { href: '/library/activity/', label: 'Activity feed' },
      { href: '/library/discover/', label: 'Discover' },
    ],
  },
]

// Rows overlap (Watched and Movies read the same snapshot), so the headline total
// counts each snapshot once rather than adding the per-row numbers together.
const allFiles = new Set<string>()
for (const g of groups) for (const l of g.links) for (const f of l.files ?? []) allFiles.add(f)
const grandTotal = [...allFiles].reduce((n, f) => n + count(f), 0)
---

<Layout title="Library" description="Every library section, with what is actually in it." active="/library/">
  <div class="page-header">
    <div class="kicker">LIBRARY</div>
    <h1>Media library</h1>
    <p class="muted">
      {grandTotal} items across {groups.length} collections. Counts come from the last data refresh;
      <a href="/me/sources/">see which services are reporting</a>.
    </p>
  </div>

  {groups.map((g) => (
    <section class="group">
      <div class="group-head">
        <h2>{g.title}</h2>
        <p>{g.note}</p>
      </div>
      <ul>
        {g.links.map((l) => {
          const n = l.files ? [...new Set(l.files)].reduce((s, f) => s + count(f), 0) : null
          return (
            <li>
              <a href={l.href}>
                <span class="lbl">{l.label}</span>
                <span class="n">{n === null ? '' : n > 0 ? n : 'empty'}</span>
              </a>
            </li>
          )
        })}
      </ul>
    </section>
  ))}
</Layout>

<style>
  .group { margin-bottom: 2rem; }
  .group-head { margin-bottom: 8px; }
  .group-head h2 {
    margin: 0; font-family: var(--font-display); font-size: 1rem; font-weight: 600; color: var(--ink);
  }
  .group-head p { margin: 2px 0 0; font-size: 0.76rem; color: var(--ink-3); }

  .group ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hair); }
  .group li { border-bottom: 1px solid var(--hair); }
  .group a {
    display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
    padding: 10px 2px; color: var(--ink-2); font-size: 0.86rem;
    transition: color var(--ease), padding-left var(--ease);
  }
  .group a:hover { color: var(--ink); padding-left: 6px; }
  .lbl { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .n {
    flex: none; font-family: var(--font-mono); font-size: 0.7rem;
    color: var(--ink-4); letter-spacing: 0.04em;
  }
  .group a:hover .n { color: var(--phosphor-dim); }
</style>
