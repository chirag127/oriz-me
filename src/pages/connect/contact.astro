---
import Layout from '~/layouts/Layout.astro'
import { SITE } from '~/lib/site'
---
<Layout title="Contact" description="Chirag Singhal — send a message">
  <div class="page-header">
    <div class="kicker">CONTACT</div>
    <h1>Send a message</h1>
    <p class="muted">I usually reply within a day. The form opens your mail app with the message ready to send.</p>
  </div>

  <div class="contact">
    <form id="contact-form" novalidate>
      <label>Name
        <input name="name" required autocomplete="name" placeholder="Your name" />
      </label>
      <label>Email
        <input name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
      </label>
      <label>Message
        <textarea name="message" required rows="5" placeholder="What's on your mind?"></textarea>
      </label>
      <button type="submit" class="btn-primary">Open in mail app</button>
      <p class="hint" id="contact-status" role="status" aria-live="polite">
        Or write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a> directly.
      </p>
    </form>
  </div>
</Layout>

<style>
  .contact { max-width: 480px; }
  form { display: flex; flex-direction: column; gap: 14px; }
  label { display: flex; flex-direction: column; gap: 5px; font-size: 12px; color: var(--ink-2); }
  input, textarea {
    background: var(--panel); border: 1px solid var(--hair); border-radius: var(--r-md);
    padding: 9px 12px; font: inherit; font-size: 13.5px; color: var(--ink);
  }
  input:focus, textarea:focus { border-color: var(--phosphor-dim); outline: none; }
  textarea { resize: vertical; }
  .btn-primary { align-self: flex-start; margin-top: 2px; }
  .hint { font-size: 12px; color: var(--ink-3); margin: 0; }
  .hint a { color: var(--phosphor); }
</style>

<script>
  // A static site has no form backend worth trusting: Web3Forms needs an access
  // key that would ship in the bundle, and the old form shipped the literal
  // placeholder, so every submission failed silently. A mailto handoff needs no
  // key, no server and no account, and the visitor sees the message they send.
  const form = document.getElementById('contact-form') as HTMLFormElement | null
  const status = document.getElementById('contact-status')
  const email = document.querySelector('.hint a')?.textContent ?? 'chirag@oriz.in'

  form?.addEventListener('submit', (e) => {
    e.preventDefault()
    const data = new FormData(form)
    const name = String(data.get('name') ?? '').trim()
    const from = String(data.get('email') ?? '').trim()
    const message = String(data.get('message') ?? '').trim()
    if (!name || !from || !message) {
      if (status) status.textContent = 'Fill in your name, email and message first.'
      return
    }
    const subject = `Message from ${name} via me.oriz.in`
    const body = `${message}\n\n— ${name}\n${from}`
    const href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
    window.location.href = href
    if (status) {
      status.textContent = 'Your mail app should be open. If nothing happened, write to ' + email + ' directly.'
    }
  })
</script>
