---
/**
 * /work/projects — curated featured work on top, then every other public
 * repository generated from the GitHub snapshot. Nothing hand-maintained goes
 * stale: the featured cards take their star counts from the same snapshot, and
 * the long tail is whatever the API currently reports.
 */
import Layout from '~/layouts/Layout.astro'
import { readFileSync } from 'fs'
import { join } from 'path'

type Repo = {
  name: string
  description: string | null
  html_url: string
  homepage: string | null
  language: string | null
  stargazers_count: number
  fork: boolean
  archived: boolean
  pushed_at: string
  topics?: string[]
}

const repos: Repo[] = JSON.parse(readFileSync(join(process.cwd(), 'public/data/github-repos.json'), 'utf-8'))
const byName = new Map(repos.map((r) => [r.name, r]))
const stars = (name: string) => byName.get(name)?.stargazers_count ?? 0

const FEATURED = [
  {
    name: 'oriz.in',
    repo: null,
    desc: 'Free, privacy-first family of client-side web tools and live-data APIs — runs in the browser or on Cloudflare Workers, with no server for end users.',
    tech: ['Astro', 'React', 'TypeScript', 'Cloudflare'],
    github: 'https://github.com/chirag127',
    live: 'https://oriz.in',
    band: true,
  },
  {
    name: 'Clear-Thought-MCP-server',
    repo: 'Clear-Thought-MCP-server',
    desc: '16 structured-thinking tools — sequential reasoning, mental-model selection, debugging frameworks — exposed as an MCP server any agent can call.',
    tech: ['TypeScript', 'MCP SDK'],
    github: 'https://github.com/chirag127/Clear-Thought-MCP-server',
    live: null,
  },
  {
    name: 'morphe-patches',
    repo: 'morphe-patches',
    desc: 'Public Morphe patch sources: device-detection removal for Android apps, kept as readable patch sets rather than opaque binaries.',
    tech: ['Java', 'Android', 'Patching'],
    github: 'https://github.com/chirag127/morphe-patches',
    live: null,
  },
  {
    name: 'bookmark-mind',
    repo: 'bookmark-mind',
    desc: 'Browser extension that auto-organises bookmarks with a local LLM call — zero cloud round-trip, nothing leaves the machine.',
    tech: ['JavaScript', 'Chrome Ext', 'LLM'],
    github: 'https://github.com/chirag127/bookmark-mind',
    live: 'https://bookmark-mind.oriz.in',
  },
  {
    name: 'Stochastic-Thinking-MCP-Server',
    repo: 'Stochastic-Thinking-MCP-Server',
    desc: 'MCP server exposing probabilistic and Bayesian reasoning primitives to agents, with a live demo site.',
    tech: ['JavaScript', 'MCP SDK'],
    github: 'https://github.com/chirag127/Stochastic-Thinking-MCP-Server',
    live: 'https://stochastic-thinking-mcp-server.oriz.in',
  },
  {
    name: 'youtube-ai-navigator-bs-ext',
    repo: 'youtube-ai-navigator-bs-ext',
    desc: 'Browser extension with Gemini-powered chapter summaries, transcript search and topic Q&A inline on YouTube.',
    tech: ['JavaScript', 'Browser Ext', 'Gemini'],
    github: 'https://github.com/chirag127/youtube-ai-navigator-bs-ext',
    live: 'https://yt-nav.oriz.in',
  },
  {
    name: 'OmniDistribute',
    repo: 'OmniDistribute',
    desc: 'Idempotent multi-channel syndication engine: adapter pattern plus a circuit breaker for at-least-once delivery.',
    tech: ['TypeScript', 'Adapter pattern'],
    github: 'https://github.com/chirag127/OmniDistribute',
    live: 'https://omnidistribute.oriz.in',
  },
  {
    name: 'olivia',
    repo: 'olivia',
    desc: 'Offline-capable Windows voice assistant: local Whisper speech-to-text and a plugin architecture.',
    tech: ['Python', 'Whisper'],
    github: 'https://github.com/chirag127/olivia',
    live: null,
  },
]

const featuredNames = new Set(
  FEATURED.map((f) => f.repo).filter(Boolean) as string[],
)
// The long tail: real projects only. Forks, archived repos and anything with no
// description are noise at this length, so they stay on GitHub and out of here.
const rest = repos
  .filter((r) => !r.fork && !r.archived && r.description && !featuredNames.has(r.name) && r.name !== 'chirag127')
  .sort((a, b) => b.stargazers_count - a.stargazers_count || +new Date(b.pushed_at) - +new Date(a.pushed_at))

const usable = repos.filter((r) => !r.fork && !r.archived && r.description).length
const totalStars = repos.reduce((n, r) => n + r.stargazers_count, 0)
---

<Layout title="Projects" description="Chirag Singhal — open source projects" active="/work/projects">
  <div class="page-header">
    <div class="kicker">WORK · PROJECTS</div>
    <h1>Projects</h1>
    <p class="muted">
      {usable} public repositories, {totalStars} stars. Eight below are the ones worth reading first;
      the rest is generated from the GitHub snapshot, so it stays current without being curated.
    </p>
  </div>

  <div class="grid">
    {FEATURED.map((p) => (
      <article class:list={['card', { featured: p.band }]}>
        {p.band && <div class="band" />}
        <div class="head">
          <h2>{p.name}</h2>
          {p.repo && stars(p.repo) > 0 && <span class="stars">{stars(p.repo)}★</span>}
          {p.live && <span class="pill">live</span>}
        </div>
        <p class="desc">{p.desc}</p>
        <div class="chips">{p.tech.map((t) => <span class="chip">{t}</span>)}</div>
        <div class="links">
          <a href={p.github} target="_blank" rel="noopener">GitHub ↗</a>
          {p.live && <a href={p.live} target="_blank" rel="noopener">Live ↗</a>}
        </div>
      </article>
    ))}
  </div>

  <section class="tail">
    <div class="tail-head">
      <h2>Everything else</h2>
      <p>{rest.length} more repositories, by stars then most recent push</p>
    </div>
    <ul>
      {rest.map((r) => (
        <li>
          <a href={r.html_url} target="_blank" rel="noopener">
            <span class="rname">{r.name}</span>
            <span class="rdesc">{r.description}</span>
            <span class="rmeta">
              {r.language && <span class="lang">{r.language}</span>}
              {r.stargazers_count > 0 && <span class="rstar">{r.stargazers_count}★</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="tail-foot"><a href="https://github.com/chirag127?tab=repositories">All repositories on GitHub ↗</a></p>
  </section>
</Layout>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .card {
    display: flex; flex-direction: column; gap: 9px;
    padding: 16px 18px; background: var(--panel); border: 1px solid var(--hair);
    border-radius: var(--r-md); overflow: hidden; position: relative;
  }
  .card.featured { grid-column: 1 / -1; }
  .band { position: absolute; inset: 0 0 auto; height: 2px; background: linear-gradient(90deg, var(--phosphor), transparent); }
  .head { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .head h2 { margin: 0; font-family: var(--font-display); font-size: 1rem; font-weight: 650; color: var(--ink); }
  .stars, .pill { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.04em; }
  .stars { color: var(--amber); }
  .pill { color: var(--phosphor); border: 1px solid color-mix(in srgb, var(--phosphor) 40%, transparent); border-radius: 3px; padding: 1px 5px; }
  .desc { margin: 0; font-size: 0.84rem; line-height: 1.5; color: var(--ink-2); }
  .chips { display: flex; flex-wrap: wrap; gap: 5px; }
  .chip { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.04em; color: var(--ink-3); border: 1px solid var(--hair); border-radius: 3px; padding: 1px 5px; }
  .links { display: flex; gap: 14px; margin-top: 2px; }
  .links a { font-size: 0.76rem; color: var(--ink-3); }
  .links a:hover { color: var(--phosphor); }

  .tail { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--hair); }
  .tail-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
  .tail-head h2 { margin: 0; font-family: var(--font-display); font-size: 1rem; color: var(--ink); }
  .tail-head p { margin: 0; font-size: 0.72rem; color: var(--ink-4); }
  .tail ul { list-style: none; margin: 0; padding: 0; }
  .tail li { border-bottom: 1px solid var(--hair); }
  .tail a { display: grid; grid-template-columns: 15rem minmax(0, 1fr) auto; gap: 14px; align-items: baseline; padding: 8px 2px; }
  .rname { font-family: var(--font-mono); font-size: 0.76rem; color: var(--ink); overflow: hidden; text-overflow: ellipsis; }
  .rdesc { font-size: 0.78rem; color: var(--ink-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rmeta { display: flex; gap: 10px; font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-4); }
  .tail a:hover .rname, .tail a:hover .rdesc { color: var(--phosphor); }
  .tail-foot { margin-top: 1rem; font-size: 0.78rem; }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .tail a { grid-template-columns: 1fr auto; }
    .rdesc { display: none; }
  }
</style>
