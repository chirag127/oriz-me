---
/**
 * /work/skills — derived, not asserted.
 *
 * Every entry is a topic or language that actually appears in the GitHub
 * snapshot, with the number of repositories behind it. A skill with zero
 * repositories is not rendered at all, so the page cannot claim something the
 * code does not show. Languages come from the repo's own language field; the
 * rest are repo topics, which authors maintain deliberately.
 */
import Layout from '~/layouts/Layout.astro'
import { readFileSync } from 'fs'
import { join } from 'path'

type Repo = { name: string; description: string | null; language: string | null; topics?: string[]; fork: boolean; archived: boolean }

const repos: Repo[] = JSON.parse(readFileSync(join(process.cwd(), 'public/data/github-repos.json'), 'utf-8')).filter(
  (r) => !r.fork && !r.archived,
)

const tally = (pick: (r: Repo) => string[]): Map<string, number> => {
  const m = new Map<string, number>()
  for (const r of repos) for (const k of pick(r)) m.set(k, (m.get(k) ?? 0) + 1)
  return m
}

const languages = tally((r) => (r.language ? [r.language] : []))
const topics = tally((r) => r.topics ?? [])

// Topic names on GitHub are lowercase and hyphenated; these are the spellings
// that belong on a CV.
const LABELS: Record<string, string> = {
  typescript: 'TypeScript', javascript: 'JavaScript', python: 'Python', astro: 'Astro',
  'cloudflare-pages': 'Cloudflare Pages', 'cloudflare-workers': 'Cloudflare Workers',
  'client-side': 'Client-side apps', 'no-server': 'Serverless', 'static-site': 'Static sites',
  'browser-tool': 'Browser tools', 'browser-extension': 'Browser extensions',
  'chrome-extension': 'Chrome extensions', 'manifest-v3': 'Manifest V3',
  tampermonkey: 'Tampermonkey', scriptcat: 'ScriptCat', violentmonkey: 'Violentmonkey',
  userscript: 'Userscripts', pwa: 'PWA', 'github-actions': 'GitHub Actions',
  'web-scraping': 'Web scraping', 'developer-tools': 'Developer tools', cli: 'CLI tools',
  automation: 'Automation', devops: 'DevOps', finance: 'Finance data', india: 'India data',
  'model-context-protocol': 'Model Context Protocol', mcp: 'MCP servers', llm: 'LLM apps',
  nlp: 'NLP', rag: 'RAG', ai: 'AI features', gemini: 'Gemini', groq: 'Groq',
  mistral: 'Mistral', nvidia: 'NVIDIA NIM', openai: 'OpenAI APIs', react: 'React',
  tailwindcss: 'Tailwind CSS', nextjs: 'Next.js', nodejs: 'Node.js', fastapi: 'FastAPI',
  express: 'Express', redis: 'Redis', firebase: 'Firebase', razorpay: 'Razorpay',
  pdf: 'PDF tooling', ocr: 'OCR', 'markdown': 'Markdown', blog: 'Blogs',
  productivity: 'Productivity', youtube: 'YouTube tooling', 'indian-stock-market': 'Stock market data',
  fintech: 'Fintech', agent: 'Agents', embeddings: 'Embeddings', 'vector-database': 'Vector DBs',
  postgres: 'Postgres', postgresql: 'Postgres', sqlite: 'SQLite', mongodb: 'MongoDB',
  supabase: 'Supabase', turso: 'Turso', docker: 'Docker', deno: 'Deno', bun: 'Bun',
}

const label = (k: string) => LABELS[k] ?? k.replace(/-/g, ' ').replace(/^\w/, (c) => c.toUpperCase())

type Skill = { name: string; n: number }
const fromTopics = (...keys: string[]): Skill[] =>
  keys
    .map((k) => ({ name: label(k), n: topics.get(k) ?? 0 }))
    .filter((s) => s.n > 0)
    .sort((a, b) => b.n - a.n)

const languageSkills: Skill[] = [...languages.entries()]
  .filter(([l]) => !['HTML', 'CSS'].includes(l))
  .map(([l, n]) => ({ name: l, n }))
  .sort((a, b) => b.n - a.n)
  .slice(0, 9)

const GROUPS = [
  {
    title: 'Languages',
    note: 'From each repository’s primary language',
    items: [...languageSkills, { name: 'HTML/CSS', n: (languages.get('HTML') ?? 0) + (languages.get('CSS') ?? 0) }],
  },
  {
    title: 'Browsers and userscripts',
    note: 'The largest single cluster in the account',
    items: fromTopics('userscript', 'tampermonkey', 'scriptcat', 'violentmonkey', 'browser-tool', 'browser-extension', 'chrome-extension', 'manifest-v3'),
  },
  {
    title: 'Frontend and delivery',
    note: '',
    items: [...fromTopics('astro', 'pwa', 'static-site', 'react', 'tailwindcss', 'nextjs'), { name: 'Astro', n: topics.get('astro') ?? 0 }].filter((s) => s.n > 0),
  },
  {
    title: 'Backend and runtime',
    note: '',
    items: fromTopics('client-side', 'no-server', 'nodejs', 'fastapi', 'express', 'web-scraping', 'cli', 'automation'),
  },
  {
    title: 'AI and LLM work',
    note: '',
    items: fromTopics('ai', 'rag', 'mcp', 'model-context-protocol', 'llm', 'nlp', 'gemini', 'groq', 'mistral', 'nvidia', 'openai', 'embeddings', 'agent'),
  },
  {
    title: 'Data and storage',
    note: '',
    items: fromTopics('postgres', 'postgresql', 'sqlite', 'mongodb', 'supabase', 'turso', 'redis', 'firebase', 'vector-database'),
  },
  {
    title: 'Infrastructure and CI',
    note: '',
    items: fromTopics('cloudflare-pages', 'cloudflare-workers', 'github-actions', 'devops', 'docker', 'razorpay', 'firebase'),
  },
  {
    title: 'Domains and output',
    note: 'What the repos are about',
    items: fromTopics('finance', 'fintech', 'india', 'indian-stock-market', 'developer-tools', 'productivity', 'youtube', 'pdf', 'ocr', 'markdown', 'blog'),
  },
].filter((g) => g.items.some((i) => i.n > 0))

const seen = new Set<string>()
const technologies = new Set<string>()
for (const g of GROUPS) for (const i of g.items) technologies.add(i.name)
const totalSkills = [...technologies].filter((n) => !seen.has(n) && (seen.add(n), true)).length
const totalStars = repos.reduce((n, r) => n + ((r as unknown as { stargazers_count: number }).stargazers_count ?? 0), 0)
---

<Layout title="Skills" description="Chirag Singhal — technologies, counted from his repositories." active="/work/skills">
  <div class="page-header">
    <div class="kicker">WORK · SKILLS</div>
    <h1>Skills</h1>
    <p class="muted">
      Counted from {repos.length} public repositories, not typed from memory. Each chip shows how many
      repos use it; anything with zero repos is not listed.
    </p>
  </div>

  <div class="stats">
    <div class="stat"><span class="n">{GROUPS.length}</span><span class="l">DOMAINS</span></div>
    <div class="stat"><span class="n">{totalSkills}</span><span class="l">TECHNOLOGIES</span></div>
    <div class="stat"><span class="n">{repos.length}</span><span class="l">REPOS ANALYSED</span></div>
    <div class="stat"><span class="n">{totalStars}</span><span class="l">STARS</span></div>
  </div>

  {GROUPS.map((g) => (
    <section class="group">
      <div class="group-head">
        <h2>{g.title}</h2>
        {g.note && <p>{g.note}</p>}
      </div>
      <ul class="chips">
        {g.items.map((i) => (
          <li class:list={['chip', { strong: i.n >= 10 }]}>
            <span class="cn">{i.name}</span>
            <span class="cc">{i.n}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p class="foot">
    Source: <a href="/work/projects/">the same GitHub snapshot the projects page uses</a>.
    Topic counts reflect what each repository is tagged with; a repo can carry several.
  </p>
</Layout>

<style>
  .stats { display: flex; gap: 2.5rem; flex-wrap: wrap; margin: 0 0 2.2rem; }
  .stat { display: flex; flex-direction: column; gap: 2px; }
  .stat .n { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; color: var(--ink); }
  .stat .l { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.09em; color: var(--ink-4); }

  .group { margin-bottom: 1.7rem; }
  .group-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
  .group-head h2 {
    margin: 0; font-family: var(--font-mono); font-size: 10.5px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3);
  }
  .group-head p { margin: 0; font-size: 11px; color: var(--ink-4); }

  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; }
  .chip {
    display: inline-flex; align-items: baseline; gap: 7px;
    padding: 5px 9px; border: 1px solid var(--hair); border-radius: var(--r-sm);
    background: var(--panel); font-size: 0.8rem; color: var(--ink-2);
  }
  .chip.strong { color: var(--ink); border-color: color-mix(in srgb, var(--phosphor) 28%, transparent); }
  .cc { font-family: var(--font-mono); font-size: 9.5px; color: var(--ink-4); }
  .chip.strong .cc { color: var(--phosphor-dim); }

  .foot { margin-top: 1.6rem; font-size: 0.74rem; color: var(--ink-4); border-top: 1px solid var(--hair); padding-top: 0.9rem; }
</style>
