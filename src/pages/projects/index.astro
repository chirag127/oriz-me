---
import Layout from '~/layouts/Layout.astro'

const projects = [
  {
    name: 'Clear-Thought-MCP-Server — Systematic Thinking & Mental Models',
    url: 'https://github.com/chirag127/Clear-Thought-MCP-server',
    urlLabel: 'github.com/chirag127/Clear-Thought-MCP-server',
    github: 'https://github.com/chirag127/Clear-Thought-MCP-server',
    stack: ['TypeScript', 'MCP SDK'],
    bullets: [
      'Implements 16 structured-thinking tools (sequential reasoning, mental-model selection, debugging frameworks) as a Model Context Protocol server; consumed by MCP-compatible AI clients.',
      'Clean TypeScript SDK surface; zero runtime dependencies beyond the MCP SDK.',
    ],
  },
  {
    name: 'bookmark-mind — AI Bookmark Organiser',
    url: 'https://bookmark-mind.oriz.in',
    urlLabel: 'github.com/chirag127/bookmark-mind · bookmark-mind.oriz.in',
    github: 'https://github.com/chirag127/bookmark-mind',
    stack: ['JavaScript', 'Chrome Extension'],
    bullets: [
      'Chrome extension that auto-categorises saved bookmarks using a local LLM call; zero cloud round-trip for classification.',
      'Ships as a polished popup UI with folder management and one-click reorganise.',
    ],
  },
  {
    name: 'Stochastic-Thinking-MCP-Server — Probabilistic Reasoning',
    url: 'https://stochastic-thinking-mcp-server.oriz.in',
    urlLabel: 'github.com/chirag127/Stochastic-Thinking-MCP-Server · stochastic-thinking-mcp-server.oriz.in',
    github: 'https://github.com/chirag127/Stochastic-Thinking-MCP-Server',
    stack: ['JavaScript', 'MCP SDK'],
    bullets: [
      'MCP server exposing probabilistic and Bayesian reasoning primitives to AI agents.',
      'Companion site provides a live interactive demo of each thinking mode.',
    ],
  },
  {
    name: 'youtube-ai-navigator-bs-ext — YouTube AI Navigator',
    url: 'https://yt-nav.oriz.in',
    urlLabel: 'github.com/chirag127/youtube-ai-navigator-bs-ext · yt-nav.oriz.in',
    github: 'https://github.com/chirag127/youtube-ai-navigator-bs-ext',
    stack: ['JavaScript', 'Browser Extension', 'Gemini'],
    bullets: [
      'Browser extension surfacing Gemini-powered chapter summaries, transcript search, and topic Q&A inline on YouTube pages.',
    ],
  },
  {
    name: 'OmniDistribute — Content Syndication Engine',
    url: 'https://omnidistribute.oriz.in',
    urlLabel: 'github.com/chirag127/OmniDistribute · omnidistribute.oriz.in',
    github: 'https://github.com/chirag127/OmniDistribute',
    stack: ['TypeScript', 'Adapter Pattern'],
    bullets: [
      'Resilient, idempotent multi-channel syndication engine; adapter pattern decouples channels (email, Telegram, webhook) from delivery logic.',
      'Circuit-breaker and retry strategies ensure at-least-once delivery under partial outages.',
    ],
  },
  {
    name: 'olivia — Python Voice Assistant',
    url: 'https://github.com/chirag127/olivia',
    urlLabel: 'github.com/chirag127/olivia',
    github: 'https://github.com/chirag127/olivia',
    stack: ['Python', 'Whisper'],
    bullets: [
      'Modular, offline-capable voice assistant for Windows; speech-to-text via a local Whisper model, plugin architecture for extensibility.',
    ],
  },
  {
    name: 'sponsorblock-ai — ML-Powered Sponsor Detection',
    url: 'https://github.com/chirag127/sponsorblock-ai',
    urlLabel: 'github.com/chirag127/sponsorblock-ai',
    github: 'https://github.com/chirag127/sponsorblock-ai',
    stack: ['Python', 'Transformers'],
    bullets: [
      'Fine-tuned sequence classifier for sponsor, intro, and outro segment detection in YouTube video transcripts.',
    ],
  },
  {
    name: 'oriz.in — Free Browser-Based Tools & Live-Data APIs',
    url: 'https://oriz.in',
    urlLabel: 'oriz.in · github.com/chirag127',
    github: 'https://github.com/chirag127',
    stack: ['Astro', 'React', 'TypeScript', 'Cloudflare'],
    bullets: [
      'A growing family of free, privacy-first, client-side web tools and live-data APIs; all compute runs in the browser or on Cloudflare Workers — no server required for end users.',
      'Publishes reusable @chirag127/* npm packages (design-system atoms, keyless multi-provider LLM client).',
    ],
  },
]
---

<Layout title="Projects" description="Open-source projects — MCP servers, browser extensions, AI tools, and the oriz.in family of free web tools." active="/projects/">

  <div class="section-title">
    <span class="kicker">Key Projects</span>
    <h1>Projects</h1>
  </div>

  <div class="projects-grid">
    {projects.map(p => (
      <article class="card project-card">
        <h2 class="project-name">{p.name}</h2>

        <div class="chip-row">
          {p.stack.map(tech => (
            <span class="chip">{tech}</span>
          ))}
        </div>

        <ul class="project-bullets">
          {p.bullets.map(b => (
            <li>{b}</li>
          ))}
        </ul>

        <div class="project-links">
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link"
          >{p.urlLabel}</a>
        </div>
      </article>
    ))}
  </div>

</Layout>

<style>
.section-title {
  margin-bottom: 2.5rem;
}

.section-title h1 {
  font-family: system-ui, -apple-system, sans-serif;
  font-weight: 600;
  letter-spacing: -0.02em;
  font-size: 2rem;
  color: var(--fg);
  margin-top: 0.25rem;
}

.projects-grid {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.project-card {
  padding: 1.5rem;
}

.project-name {
  font-family: Charter, "Bitstream Charter", Cambria, Georgia, serif;
  font-weight: 500;
  font-size: 1.15rem;
  letter-spacing: -0.01em;
  color: var(--fg);
  margin-bottom: 0.75rem;
  max-width: none;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
  margin-bottom: 1rem;
}

.project-bullets {
  list-style: none;
  padding: 0;
  margin: 0 0 1.1rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  max-width: 70ch;
}

.project-bullets li {
  font-family: Charter, "Bitstream Charter", Cambria, Georgia, serif;
  font-size: 0.925rem;
  color: var(--muted);
  line-height: 1.55;
  padding-left: 1em;
  position: relative;
  max-width: none;
}

.project-bullets li::before {
  content: '–';
  position: absolute;
  left: 0;
  color: var(--faint);
}

.project-links {
  border-top: 1px solid var(--rule);
  padding-top: 0.75rem;
}

.project-link {
  font-family: ui-monospace, "Cascadia Code", "SF Mono", Menlo, monospace;
  font-size: 0.78rem;
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 0.2em;
  text-decoration-thickness: 1px;
  word-break: break-all;
}

.project-link:hover {
  text-decoration-thickness: 2px;
}
</style>
