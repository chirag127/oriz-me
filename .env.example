# oriz-me — env template (names only, no values). Copy to .env and fill in.
#
# Nothing here is required for the site to build: every feed degrades to the
# last committed snapshot in public/data/, and every PUBLIC_* var falls back to
# the live me.oriz.in value. Fill only the feeds you want.
#
# Umbrella users: do not edit this copy. Run `node scripts/env-sync.mjs` at the
# workspace root — it projects the root .env into this directory's .env.
# Fork users: cp .env.example .env and fill in what you have.

# ── Identity (PUBLIC_* is inlined into the browser bundle) ──
# Canonical URL, og:url, sitemap and PWA manifest. No trailing slash.
PUBLIC_SITE_URL=https://me.oriz.in
# Display name, initials, role, employer → titles, JSON-LD, rail header.
PUBLIC_OWNER_NAME=Chirag Singhal
PUBLIC_OWNER_INITIALS=CS
PUBLIC_OWNER_ROLE=Software Engineer
PUBLIC_OWNER_EMPLOYER=Tata Consultancy Services
# networth unlock challenge + contact links.
PUBLIC_OWNER_EMAIL=
PUBLIC_OWNER_GITHUB=
PUBLIC_OWNER_LINKEDIN=
PUBLIC_OWNER_X=
# Rail wordmark: set to your own domain, or blank both for no wordmark.
PUBLIC_FAMILY_NAME=oriz.in
PUBLIC_FAMILY_URL=https://oriz.in
# Plausible only loads when this equals location.hostname. Empty = no analytics.
PUBLIC_ANALYTICS_DOMAIN=
# false removes the hire-me footer.
PUBLIC_HIRE_ME=true

# ── Auth + storage (optional; gates nothing public) ──
# Clerk publishable key. Absent = sign-in islands render signed-out.
PUBLIC_CLERK_PUBLISHABLE_KEY=
# Firebase Web config for cross-site bookmarks. Absent = bookmarks stay local.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# ── Build-time feeds (never shipped to the browser) ──
# Handle-only vars need no key. Keyed feeds are skipped when the key is absent,
# leaving the committed public/data/*.json snapshot untouched.

# Trakt — movies + TV. Public endpoints need only the client id; history of a
# private profile needs the OAuth access token (a 403 here means the token is
# revoked or belongs to another app).
TRAKT_CLIENT_ID=
TRAKT_ACCESS_TOKEN=
TRAKT_USERNAME=
# MyAnimeList official API (client id from mal.developers) + a second anime
# source, AniList (handle only).
MAL_CLIENT_ID=
MAL_USERNAME=
ANILIST_USERNAME=
# Last.fm scrobbles, and ListenBrainz as a keyless second listen source.
LASTFM_API_KEY=
LASTFM_USERNAME=
LISTENBRAINZ_USERNAME=
# Books: Hardcover (GraphQL bearer token) is the live source; Goodreads and
# OpenLibrary stay as legacy snapshots (Goodreads has had no public API since
# 2020, OpenLibrary needs an existing /people/<name> account).
HARDCOVER_TOKEN=
HARDCOVER_USERNAME=
GOODREADS_USER_ID=
OL_USERNAME=
# Board games (BGG XML API2 now requires a bearer token) + video games.
BGG_USERNAME=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
STEAM_API_KEY=
# 64-bit numeric SteamID, not the vanity name.
STEAM_ID=
# Presence, repos, packages, writing.
DISCORD_USER_ID=
GH_USERNAME=
NPM_USERNAME=
DEVTO_USERNAME=
HASHNODE_USERNAME=
PRODUCTHUNT_TOKEN=
# TMDB bearer read-access token — discover rows + poster enrichment.
TMDB_READ_ACCESS_TOKEN=
# Habitica, Toggl, WakaTime. A 401 from WakaTime means the key was rotated.
HABITICA_USER_ID=
HABITICA_API_TOKEN=
TOGGL_API_TOKEN=
WAKATIME_API_KEY=
# Podcast Index (free key + secret from podcastindex.org).
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
# Spotify top artists/tracks — needs OAuth client + a refresh token with the
# user-top-read scope. A 400 on refresh means the refresh token was revoked.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Notion journal database shared with the integration.
NOTION_TOKEN=
NOTION_JOURNAL_DB_ID=
# Gmail inbox + Maps timeline exports (OAuth refresh token).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
